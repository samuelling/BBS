{
  "name": "septic-tankz",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python3 build.py",
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply septic-tankz --local",
    "deploy": "node scripts/provision.mjs && wrangler d1 migrations apply septic-tankz --remote && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.147.0"
  }
}
